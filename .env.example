# CareLoop Environment Configuration
# NO SECRETS OR EXTERNAL API KEYS REQUIRED.
# CareLoop runs 100% locally out-of-the-box with deterministic synthetic seeder.

# Storage backend (default: false -> uses local deterministic in-memory store backed by committed synthetic JSON)
USE_SUPABASE=false

# Optional Supabase credentials (only required if USE_SUPABASE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
